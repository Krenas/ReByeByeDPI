<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <Preference
        android:key="help_test_intro"
        android:title="@string/help_intro_title"
        android:summary="@string/help_intro_test"
        android:selectable="false"
        app:iconSpaceReserved="false" />

    <EditTextPreference
        android:key="byedpi_proxytest_delay"
        android:title="@string/test_delay"
        android:inputType="number"
        android:defaultValue="1"
        app:iconSpaceReserved="false" 
            android:summary="@string/proxytest_delay_desc"/>

    <EditTextPreference
        android:key="byedpi_proxytest_requests"
        android:title="@string/test_requests"
        android:inputType="number"
        android:defaultValue="1"
        app:iconSpaceReserved="false" 
            android:summary="@string/proxytest_requests_desc"/>

    <EditTextPreference
        android:key="byedpi_proxytest_limit"
        android:title="@string/test_requests_limit"
        android:inputType="number"
        android:defaultValue="20"
        app:iconSpaceReserved="false" 
            android:summary="@string/proxytest_limit_desc"/>

    <EditTextPreference
        android:key="byedpi_proxytest_timeout"
        android:title="@string/test_timeout"
        android:inputType="number"
        android:defaultValue="5"
        app:iconSpaceReserved="false" 
            android:summary="@string/proxytest_timeout_desc"/>

    <EditTextPreference
        android:key="byedpi_proxytest_sni"
        android:title="@string/test_settings_sni"
        android:inputType="text"
        android:defaultValue="google.com"
        app:iconSpaceReserved="false" 
            android:summary="@string/help_test_sni"/>

    <Preference
        android:key="manage_domain_lists"
        android:title="@string/domain_lists"
        android:summary="@string/help_test_domains"
        app:fragment="io.github.romanvht.byedpi.fragments.DomainListsFragment"
        app:iconSpaceReserved="false" />

    <SwitchPreference
        android:key="byedpi_proxytest_usercommands"
        android:title="@string/test_settings_usercommands"
        app:iconSpaceReserved="false" 
            android:summary="@string/help_test_usercommands"/>

    <EditTextPreference
        android:key="byedpi_proxytest_commands"
        android:title="@string/test_settings_commands"
        android:enabled="false"
        android:inputType="textMultiLine"
        app:iconSpaceReserved="false" 
            android:summary="@string/help_test_commands"/>

</PreferenceScreen>
